#!/bin/sh
# Rotate screen and touchscreen from the accelerometer (iio-sensor-proxy)
OUT=DSI-1
TOUCH="pointer:Goodix Capacitive TouchScreen"
stdbuf -oL monitor-sensor | while read -r line; do
  case "$line" in
    *bottom-up*) R=inverted; M="-1 0 1 0 -1 1 0 0 1" ;;
    *left-up*)   R=left;     M="0 -1 1 1 0 0 0 0 1" ;;
    *right-up*)  R=right;    M="0 1 0 -1 0 1 0 0 1" ;;
    *normal*)    R=normal;   M="1 0 0 0 1 0 0 0 1" ;;
    *) continue ;;
  esac
  # Current rotation: the word after the geometry, absent for "normal".
  CUR=$(xrandr --query) || exit 0   # X server is gone
  CUR=$(echo "$CUR" | awk -v o="$OUT" '$1 == o { for (i = 1; i <= NF; i++)
          if ($i ~ /^[0-9]+x[0-9]+\+/) { print ($(i+1) ~ /^(left|right|inverted)$/ ? $(i+1) : "normal"); exit } }')
  # A mode set wakes a blanked screen (e.g. the lock screen), so skip it if nothing changes.
  [ "$CUR" = "$R" ] || xrandr --output "$OUT" --rotate "$R"
  xinput set-prop "$TOUCH" "Coordinate Transformation Matrix" $M
done
