#!/bin/sh
# Rotate screen and touch input from the accelerometer (iio-sensor-proxy).
# TOUCH is the virtual mouse made by touch-gestures (plus its "-mt" touchscreen
# for real two-finger touches); the rotation is also written
# to /run/iconia-rotation so touch-gestures scrolls in screen direction.
# A mode set wakes a screen blanked by DPMS, so while the screen is off the new
# orientation is only remembered and applied once the screen is back on
# (checked on a "tick" every second).
OUT=DSI-1
TOUCH="${TOUCH:-iconia-touch}"

screen_off() {
  xset q 2>/dev/null | grep -qE 'Monitor is (Off|Standby|Suspend)'
}

{ stdbuf -oL monitor-sensor & while sleep 1; do echo tick; done; } | while read -r line; do
  case "$line" in
    *bottom-up*) R=inverted; M="-1 0 1 0 -1 1 0 0 1" ;;
    *left-up*)   R=left;     M="0 -1 1 1 0 0 0 0 1" ;;
    *right-up*)  R=right;    M="0 1 0 -1 0 1 0 0 1" ;;
    *normal*)    R=normal;   M="1 0 0 0 1 0 0 0 1" ;;
    tick) [ -n "$R" ] || continue ;;   # retry a postponed rotation
    *) continue ;;
  esac
  screen_off && continue   # keep R/M, apply on a later tick
  # Current rotation: the word after the geometry, absent for "normal".
  CUR=$(xrandr --query) || exit 0   # X server is gone
  CUR=$(echo "$CUR" | awk -v o="$OUT" '$1 == o { for (i = 1; i <= NF; i++)
          if ($i ~ /^[0-9]+x[0-9]+\+/) { print ($(i+1) ~ /^(left|right|inverted)$/ ? $(i+1) : "normal"); exit } }')
  # Skip the mode set if nothing changes (it would also wake a blanked screen).
  [ "$CUR" = "$R" ] || xrandr --output "$OUT" --rotate "$R"
  for dev in "$TOUCH" "$TOUCH-mt"; do
    xinput set-prop "$dev" "Coordinate Transformation Matrix" $M 2>/dev/null
  done
  echo "$R" > /run/iconia-rotation 2>/dev/null
  R=   # done, nothing pending
done
