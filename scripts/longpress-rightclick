#!/usr/bin/python3
"""Long press on the touchscreen -> right click.

The right click is sent while the finger is still down (after HOLD seconds).
The context menu opens and grabs the pointer, so lifting the finger can't
"click" the item under it (in single-click mode that would open it) and a
multi-selection is kept.
"""
import select, sys, time, evdev
from evdev import ecodes as e

HOLD = 0.6   # seconds to hold
MOVE = 15    # allowed finger movement, px
NAME = sys.argv[1] if len(sys.argv) > 1 else "Goodix"   # touchscreen name


def find_device():
    while True:
        for path in evdev.list_devices():
            dev = evdev.InputDevice(path)
            if NAME in dev.name:
                return dev
        time.sleep(1)


dev = find_device()
ui = evdev.UInput({e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT], e.EV_REL: [e.REL_X, e.REL_Y]},
                  name="longpress-rightclick")
t0 = x0 = y0 = None   # t0: time the finger went down, None when no touch
x = y = 0
moved = multi = fired = False

while True:
    waiting = t0 is not None and not (moved or multi or fired)
    timeout = max(0.0, t0 + HOLD - time.monotonic()) if waiting else None
    if not select.select([dev], [], [], timeout)[0]:
        fired = True   # held long enough without moving: right click now
        for v in (1, 0):
            ui.write(e.EV_KEY, e.BTN_RIGHT, v)
            ui.syn()
        continue
    for ev in dev.read():
        if ev.type == e.EV_ABS:
            if ev.code == e.ABS_X: x = ev.value
            elif ev.code == e.ABS_Y: y = ev.value
            elif ev.code == e.ABS_MT_SLOT and ev.value > 0: multi = True
        elif ev.type == e.EV_KEY and ev.code == e.BTN_TOUCH:
            if ev.value == 1:
                t0, x0, moved, multi, fired = time.monotonic(), None, False, False, False
            else:
                t0 = None
        elif ev.type == e.EV_SYN and t0 is not None:
            if x0 is None: x0, y0 = x, y
            elif abs(x - x0) > MOVE or abs(y - y0) > MOVE: moved = True
